# ==============================================================================
# ROUTINE PLANNER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In Vercel, configure these variables in:
# Project Settings -> Environment Variables -> Select Production, Preview, Development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client Build)
# ------------------------------------------------------------------------------
# These variables are prefixed with VITE_ and will be embedded into the frontend bundle.
VITE_FIREBASE_API_KEY=AIzaSyCoMHQ2J2mbEUAQT-pdMYgIbQkbTvr-MKFw
VITE_FIREBASE_AUTH_DOMAIN=time-line-5bbcd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=time-line-5bbcd
VITE_FIREBASE_STORAGE_BUCKET=time-line-5bbcd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=54297778155
VITE_FIREBASE_APP_ID=1:54297778155:web:991e48b0200ee2a53cebae
VITE_FIREBASE_MEASUREMENT_ID=G-1548KQNZ0P

# Frontend API Base URL
# Leave blank (or set to /api) in Vercel to use relative routing through Vercel rewrites:
# Requests to /api/* are seamlessly routed to the Express serverless function.
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVERLESS ENVIRONMENT VARIABLES (Vercel Functions & Local API)
# ------------------------------------------------------------------------------
# These variables are kept strictly server-side and never exposed to the client bundle.
FIREBASE_PROJECT_ID=time-line-5bbcd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@time-line-5bbcd.iam.gserviceaccount.com

# Firebase Private Key (from Google Cloud Service Account JSON)
# In Vercel, paste the entire private key including the BEGIN and END header/footer.
# Escaped newlines (\n) are automatically converted at runtime in api/config/firebaseAdmin.ts.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# CORS Configuration
# Comma-separated list of allowed origins.
# Note: api/middleware/cors.ts automatically permits *.vercel.app, localhost, and capacitor://.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Local Express development port (default: 5000)
PORT=5000
